{
  "$id": "https://mdtor.app/schemas/project-v1.json",
  "title": "MDTorProject",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "mdtor-project"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "naming": {
      "type": "object",
      "properties": {
        "numbered": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "collections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "books": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "folder": {
                  "type": "string"
                },
                "items": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": {}
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "version",
    "title"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "file"
      ],
      "additionalProperties": {}
    }
  }
}
