            "right": {
              "type": "number",
              "minimum": 0,
              "maximum": 500
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 500
            },
            "left": {
              "type": "number",
              "minimum": 0,
              "maximum": 500
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "header": {
          "type": "object",
