        "size": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A4",
                "A5",
                "Letter",
                "Legal",
                "B5"
              ]
            },
            {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 50,
                  "maximum": 2000
                },
                "height": {
                  "type": "number",
                  "minimum": 50,
                  "maximum": 2000
                }
              },
              "required": [
                "width",
                "height"
              ]
